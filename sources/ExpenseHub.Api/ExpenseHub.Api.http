@ExpenseHub_Api_HostAddress = http://localhost:5245

# Senha configurada via User Secrets (Seed:Admin:Password). Não versione a senha real.
@adminPassword = <sua-senha-forte>

GET {{ExpenseHub_Api_HostAddress}}/health
Accept: application/json

###

# ---------------------------------------------------------------
# I02 — Identity, Admin e autenticação
# ---------------------------------------------------------------

# Login válido do Admin: 200 com bearer token
# @name adminLogin
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "admin@expensehub.local",
  "password": "{{adminPassword}}"
}

###

# Senha errada: 401 sem token
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "admin@expensehub.local",
  "password": "errada"
}

###

# Entrada inválida: 400
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "nao-e-email",
  "password": ""
}

###

# ---------------------------------------------------------------
# I03 — Cadastro HTTP e gerenciamento de roles
# ---------------------------------------------------------------

# Cadastro válido: 201 com roles vazias
# @name registerAna
POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "ana@empresa.com",
  "password": "Ana@12345"
}

###

# Cadastro tentando enviar roles: 400 (o cadastro não aceita roles)
POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "intruso@empresa.com",
  "password": "Intr@1234",
  "roles": ["Admin"]
}

###

# Login da Ana (ainda sem roles)
# @name anaLogin
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "ana@empresa.com",
  "password": "Ana@12345"
}

###

# Sem token: 401
GET {{ExpenseHub_Api_HostAddress}}/api/admin/users

###

# Usuário autenticado sem role Admin: 403
GET {{ExpenseHub_Api_HostAddress}}/api/admin/users
Authorization: Bearer {{anaLogin.response.body.$.accessToken}}

###

# Admin lista usuários e roles: 200
# @name users
GET {{ExpenseHub_Api_HostAddress}}/api/admin/users
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

###

# Admin atribui Employee e Approver à Ana: 200
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/{{registerAna.response.body.$.id}}/roles
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "roles": ["Employee", "Approver"]
}

###

# Role desconhecida: 400
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/{{registerAna.response.body.$.id}}/roles
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "roles": ["SuperUser"]
}

###

# Usuário inexistente: 404
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/nao-existe/roles
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "roles": ["Employee"]
}

###

# Admin tentando remover a própria role Admin: 403
# (substitua pelo id do Admin retornado em GET /api/admin/users)
PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/<id-do-admin>/roles
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "roles": ["Employee"]
}

###

# ---------------------------------------------------------------
# I04 — Criar e editar rascunho
# Pré-requisito: Ana com a role Employee (PUT de roles acima) e novo login.
# ---------------------------------------------------------------

# Novo login da Ana para o token conter as roles atribuídas
# @name anaLogin2
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "ana@empresa.com",
  "password": "Ana@12345"
}

###

# Criar rascunho: 201 em Draft, proprietário = Ana
# @name createExpense
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{anaLogin2.response.body.$.accessToken}}
Content-Type: application/json

{
  "categoryId": 2,
  "description": "Táxi do aeroporto até o cliente",
  "amount": 87.50,
  "expenseDate": "2026-10-10"
}

###

# Valor, descrição e data fora do contrato: 400
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{anaLogin2.response.body.$.accessToken}}
Content-Type: application/json

{
  "categoryId": 2,
  "description": "curta",
  "amount": 0,
  "expenseDate": "2099-01-01"
}

###

# Tentativa de mass assignment (ownerId/status): 400
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{anaLogin2.response.body.$.accessToken}}
Content-Type: application/json

{
  "categoryId": 2,
  "description": "Táxi do aeroporto até o cliente",
  "amount": 87.50,
  "expenseDate": "2026-10-10",
  "ownerId": "outro-usuario",
  "status": "Approved"
}

###

# Admin não cria reembolso: 403
POST {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "categoryId": 2,
  "description": "Táxi do aeroporto até o cliente",
  "amount": 87.50,
  "expenseDate": "2026-10-10"
}

###

# Editar o próprio rascunho: 200 (gera histórico com os campos alterados)
PUT {{ExpenseHub_Api_HostAddress}}/api/expenses/{{createExpense.response.body.$.id}}
Authorization: Bearer {{anaLogin2.response.body.$.accessToken}}
Content-Type: application/json

{
  "categoryId": 3,
  "description": "Hotel próximo ao cliente por duas noites",
  "amount": 450.00,
  "expenseDate": "2026-10-10"
}

###

# Reembolso inexistente (edição): 404
PUT {{ExpenseHub_Api_HostAddress}}/api/expenses/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{anaLogin2.response.body.$.accessToken}}
Content-Type: application/json

{
  "categoryId": 3,
  "description": "Hotel próximo ao cliente por duas noites",
  "amount": 450.00,
  "expenseDate": "2026-10-10"
}

###

# ---------------------------------------------------------------
# I05 — Enviar, listar e consultar
# ---------------------------------------------------------------

# Ana envia o próprio rascunho: 200, Draft -> Submitted
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{createExpense.response.body.$.id}}/submit
Authorization: Bearer {{anaLogin2.response.body.$.accessToken}}

###

# Envio repetido: 409 (sem duplicar histórico)
POST {{ExpenseHub_Api_HostAddress}}/api/expenses/{{createExpense.response.body.$.id}}/submit
Authorization: Bearer {{anaLogin2.response.body.$.accessToken}}

###

# Edição depois do envio: 409
PUT {{ExpenseHub_Api_HostAddress}}/api/expenses/{{createExpense.response.body.$.id}}
Authorization: Bearer {{anaLogin2.response.body.$.accessToken}}
Content-Type: application/json

{
  "categoryId": 3,
  "description": "Tentando editar depois de enviar",
  "amount": 1.00,
  "expenseDate": "2026-10-10"
}

###

# Listagem da Ana (Employee + Approver): os próprios e os Submitted
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{anaLogin2.response.body.$.accessToken}}

###

# Detalhe visível: 200
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{createExpense.response.body.$.id}}
Authorization: Bearer {{anaLogin2.response.body.$.accessToken}}

###

# Admin sem outra role não consulta reembolsos: 403
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

###

# Bruno: cadastro, role Employee atribuída pelo Admin e login
# @name registerBruno
POST {{ExpenseHub_Api_HostAddress}}/register
Content-Type: application/json

{
  "email": "bruno@empresa.com",
  "password": "Bruno@123"
}

###

PUT {{ExpenseHub_Api_HostAddress}}/api/admin/users/{{registerBruno.response.body.$.id}}/roles
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "roles": ["Employee"]
}

###

# @name brunoLogin
POST {{ExpenseHub_Api_HostAddress}}/login
Content-Type: application/json

{
  "email": "bruno@empresa.com",
  "password": "Bruno@123"
}

###

# Bruno troca o id na URL para o reembolso da Ana: 404 (não vaza dados)
GET {{ExpenseHub_Api_HostAddress}}/api/expenses/{{createExpense.response.body.$.id}}
Authorization: Bearer {{brunoLogin.response.body.$.accessToken}}

###

# Listagem do Bruno: somente os próprios (vazia)
GET {{ExpenseHub_Api_HostAddress}}/api/expenses
Authorization: Bearer {{brunoLogin.response.body.$.accessToken}}

###